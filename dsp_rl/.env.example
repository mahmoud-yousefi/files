# Copy to dsp_rl/.env (gitignored) and fill in. Never commit real values.
# API key from https://console.archil.com/api-keys — starts with key-.
# A disk/mount token (adt_...) is NOT an API key: the API answers it with HTTP 401.
ARCHIL_API_KEY=

# Keys are region-scoped; exec works in aws-us-east-1, aws-us-west-2, aws-eu-west-1.
ARCHIL_REGION=aws-us-east-1

# Disk id (dsk-...) used by archil_store.py; archil_persist_check.py creates one and
# records its id here when this is empty.
ARCHIL_DISK_ID=
